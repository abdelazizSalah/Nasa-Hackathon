% Mission Forge standalone proof; educational two-body Earth orbit.
Create Spacecraft DemoSat;
DemoSat.DateFormat = UTCGregorian;
DemoSat.Epoch = '14 Nov 2026 12:00:00.000';
DemoSat.CoordinateSystem = EarthMJ2000Eq;
DemoSat.DisplayStateType = Keplerian;
DemoSat.SMA = 7000;
DemoSat.ECC = 0.001;
DemoSat.INC = 28.5;
DemoSat.RAAN = 0;
DemoSat.AOP = 0;
DemoSat.TA = 0;
Create ForceModel EarthModel;
EarthModel.CentralBody = Earth;
EarthModel.PrimaryBodies = {};
EarthModel.PointMasses = {Earth};
EarthModel.Drag = None;
EarthModel.SRP = Off;
Create Propagator OrbitProp;
OrbitProp.FM = EarthModel;
OrbitProp.Type = RungeKutta89;
OrbitProp.InitialStepSize = 60;
OrbitProp.Accuracy = 1e-12;
Create ReportFile Trajectory;
Trajectory.Filename = '@REPORT_PATH@';
Trajectory.Precision = 16;
Trajectory.WriteHeaders = true;
Create Variable Step;
BeginMissionSequence;
Report Trajectory DemoSat.ElapsedSecs DemoSat.A1ModJulian DemoSat.EarthMJ2000Eq.X DemoSat.EarthMJ2000Eq.Y DemoSat.EarthMJ2000Eq.Z DemoSat.EarthMJ2000Eq.VX DemoSat.EarthMJ2000Eq.VY DemoSat.EarthMJ2000Eq.VZ;
For Step = 1:10;
    Propagate OrbitProp(DemoSat) {DemoSat.ElapsedSecs = 60};
    Report Trajectory DemoSat.ElapsedSecs DemoSat.A1ModJulian DemoSat.EarthMJ2000Eq.X DemoSat.EarthMJ2000Eq.Y DemoSat.EarthMJ2000Eq.Z DemoSat.EarthMJ2000Eq.VX DemoSat.EarthMJ2000Eq.VY DemoSat.EarthMJ2000Eq.VZ;
EndFor;
